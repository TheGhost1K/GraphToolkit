{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/GraphToolkit.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "disableGitFeatures": true,
      "enumSortOrder": "declaringOrder",
      "memberLayout": "samePage",
      "namespaceLayout": "nested"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "articles/**/*.{md,yml}",
          "api/**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          "templates/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "**/*.{png,jpg,jpeg,gif,svg}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "overwrites": "overwrites/**/*.md",
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "GraphToolkit",
      "_appTitle": "GraphToolkit — Graph Algorithms for .NET",
      "_appFooter": "© GraphToolkit Contributors. Licensed under MIT.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_enableMermaid": true,
      "_gitContribute": {
        "repo": "https://github.com/TheGhost1K/GraphToolkit",
        "branch": "master"
      },
      "_lang": "en"
    },
    "markdownEngineName": "markdig",
    "markdownEngineProperties": {
      "markdigExtensions": [
        //"mermaid",
        "diagrams",
        "footnotes",
        //"tables",
        "tasklists",
        "autolinks",
        "pipeTables"
      ]
    },
    "noRestore": true,
    "templateFolder": "templates",
    "postProcessors": [
      "ExtractSearchIndex"
    ]
  }
}