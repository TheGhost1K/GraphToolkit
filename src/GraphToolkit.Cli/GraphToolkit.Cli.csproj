<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>graph-toolkit</AssemblyName>
    <RootNamespace>GraphToolkit.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>graph-toolkit</ToolCommandName>
    <PackageId>GraphToolkit.Cli</PackageId>
    <Version>1.0.0</Version>
    <Description>CLI-утилита для GraphToolkit — работа с графами из командной строки.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GraphToolkit\GraphToolkit.csproj" />
  </ItemGroup>

</Project>