<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\GraphToolkit.xml</DocumentationFile>

		<AssemblyName>GraphToolkit</AssemblyName>
		<RootNamespace>GraphToolkit</RootNamespace>
		<Version>1.0.0</Version>
		<Authors>GraphToolkit Contributors</Authors>
		<Description>Comprehensive graph algorithms toolkit for .NET: paths, trees, flows, matchings, coloring and more.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>graph;algorithms;network;flow;mst;shortest-path</PackageTags>
		<RepositoryUrl>https://github.com/GraphToolkit</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	
</Project>